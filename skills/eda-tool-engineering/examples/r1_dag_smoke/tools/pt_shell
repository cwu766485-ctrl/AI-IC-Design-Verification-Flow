#!/usr/bin/env python3
import sys
from pathlib import Path

if "-version" in sys.argv:
    print("MOCK PT 1.0 (not Synopsys)")
    raise SystemExit(0)

script = Path(sys.argv[sys.argv.index("-f") + 1])
out = script.parent
(out / "qor.rpt").write_text("Design WNS: 0.1\nDesign TNS: 0.0\n")
(out / "timing.rpt").write_text("Mock timing path\n")
(out / "constraints.rpt").write_text("No constraint violations\n")
