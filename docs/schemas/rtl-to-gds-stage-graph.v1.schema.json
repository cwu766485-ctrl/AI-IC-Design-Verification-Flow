{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aicflow.local/schemas/rtl-to-gds-stage-graph.v1.schema.json",
  "title": "AI-IC Flow RTL-to-GDS Graph Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "design", "modes", "stages", "release_gates"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benchmark", "graph_id", "description", "runtime_contracts"],
      "properties": {
        "benchmark": {"const": "NM6008 Matrix Multiplier"},
        "graph_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "description": {"type": "string", "minLength": 1},
        "runtime_contracts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage_input", "stage_result"],
          "properties": {
            "stage_input": {"const": "1.0"},
            "stage_result": {"const": "1.0"}
          }
        }
      }
    },
    "modes": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["functional_only", "full_dft"]}
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/stage"}
    },
    "release_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "mode", "required_stages", "requirements"],
        "properties": {
          "gate_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "mode": {"enum": ["functional_only", "full_dft"]},
          "required_stages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}},
          "requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "stage_kind", "tool", "adapter_id", "implementation", "modes", "dependencies", "required_inputs", "outputs", "checkpoint", "cache", "recovery", "pass_requirements"],
      "properties": {
        "stage_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "stage_kind": {"type": "string", "minLength": 1},
        "tool": {"type": "string", "minLength": 1},
        "adapter_id": {"type": "string", "minLength": 1},
        "implementation": {"enum": ["existing_limited", "planned_unverified", "internal_gate"]},
        "modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["functional_only", "full_dft"]}},
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage_id", "modes", "required_status"],
            "properties": {
              "stage_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
              "modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["functional_only", "full_dft"]}},
              "required_status": {"const": "PASS"}
            }
          }
        },
        "required_inputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "required"],
            "properties": {
              "role": {"type": "string", "minLength": 1},
              "required": {"type": "boolean"}
            }
          }
        },
        "checkpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "restore_requires"],
          "properties": {
            "strategy": {"enum": ["contract_and_outputs", "tool_database_and_outputs", "none"]},
            "restore_requires": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "required": ["eligible", "invalidation_keys"],
          "properties": {
            "eligible": {"type": "boolean"},
            "invalidation_keys": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "recovery": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "pass_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "mode_exclusion_status": {"enum": ["SKIPPED"]},
        "mode_exclusion_reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
