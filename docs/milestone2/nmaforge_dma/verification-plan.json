  "features": [
    {
      "id": "DMA-F-001",
      "name": "DDR to SPAD load with tagged, out-of-order reads",
      "spec_refs": [
        {
          "contains": "最多四个 tagged read outstanding",
          "file": "docs/spec/SPEC_ZH.md"
        },
        {
          "contains": "newest-first R",
          "file": "dv/block/dma/DMA_UVM_TESTPLAN.md"
        }
      ],
      "testpoints": [
        {
          "checker": {
            "description": "Compare every SPAD word and check the observed completion order.",
            "id": "DMA-CK-001",
            "kind": "reference_model",
            "scope": "DUT_business",
            "source": "dv/block/dma/env/dma_block_scoreboard.svh"
          },
          "coverage": [
            {
              "bins": [
                "load"
              ],
              "group": "dma_cmd_cg",
              "point": "cp_direction"
            },
            {
              "bins": [
                "four"
              ],
              "group": "dma_cmd_cg",
              "point": "cp_outstanding"
            }
          ],
          "id": "DMA-TP-001",
          "stimulus": "Accept four read bursts before returning responses, then return newest first.",
          "tests": [
            "dma_load_ooo_smoke_test"
          ]
        }
      ]
    },
    {
      "id": "DMA-F-002",
      "name": "2-D stride and indexed gather address generation",
      "spec_refs": [
        {
          "contains": "二维 row/stride、indexed gather",
          "file": "docs/spec/SPEC_ZH.md"
        },
        {
          "contains": "3×4, SPAD-held DDR row pointers",
          "file": "dv/block/dma/DMA_UVM_TESTPLAN.md"
        }
      ],
      "testpoints": [
        {
          "checker": {
            "description": "Compare generated row addresses and each transferred word against the memory model.",
            "id": "DMA-CK-002",
            "kind": "reference_model",
            "scope": "DUT_business",
            "source": "dv/block/dma/env/dma_block_scoreboard.svh"
          },
          "coverage": [
            {
              "bins": [
                "two_d"
              ],
              "group": "dma_cmd_cg",
              "point": "cp_shape"
            },
            {
              "bins": [
                "enabled"
              ],
              "group": "dma_cmd_cg",
              "point": "cp_gather"
            },
            {
              "bins": [
                "load_two_d_enabled"
              ],
              "group": "dma_cmd_cg",
              "point": "x_transfer_modes"
            }
          ],
          "id": "DMA-TP-002",
          "stimulus": "Run strided load/store rows and gather non-contiguous rows through the SPAD index table.",
          "tests": [
            "dma_2d_load_test",
            "dma_2d_store_test",
            "dma_gather_load_test"
          ]
        }
      ]
    },
    {
      "id": "DMA-F-003",
      "name": "Burst planning and 4 KiB boundary split",
      "spec_refs": [
        {
          "contains": "burst 最多 16 beats，且在每个 4 KiB AXI 边界拆分",
          "file": "docs/spec/SPEC_ZH.md"
        },
        {
          "contains": "accepted ARs are exactly `0x1ff0/LEN0` then `0x2000/LEN1`",
          "file": "dv/block/dma/DMA_UVM_TESTPLAN.md"
        }
      ],
      "testpoints": [
        {
          "checker": {
            "WLAST and WSTRB.": null,
            "data": null,
            "description": "Assert accepted AR/AW bursts never cross 4 KiB; scoreboard checks split addresses",
            "id": "DMA-CK-003",
            "kind": "protocol_sva",
            "scope": "DUT_protocol",
            "source": "dv/block/dma/assertions/ai_axi128_dma_sva.sv"
          },
          "coverage": [
            {
              "bins": [
                "yes"
              ],
              "group": "dma_cmd_cg",
              "point": "cp_4k"
            },
            {
              "bins": [
                "short",
                "multi"
              ],
              "group": "dma_cmd_cg",
              "point": "cp_length"
            }
          ],
          "id": "DMA-TP-003",
          "stimulus": "Exercise narrow transfers, a page crossing, a transfer starting one beat before the page edge, and 1/2/3-word tails.",
          "tests": [
            "dma_narrow_load_test",
            "dma_4k_load_test",
            "dma_4k_edge_load_test",
            "dma_short_tail_store_test"
          ]
        }
      ]
    },
    {
      "id": "DMA-F-004",
      "name": "Store response IDs, write stability, and completion drain",
