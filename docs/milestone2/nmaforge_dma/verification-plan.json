          ],
          "id": "DMA-TP-007",
          "status": "existing",
          "stimulus": "Reset while four DMA read addresses are accepted and before any R response, then repeat after the first R beat and run a post-reset recovery transfer.",
          "tests": [
            "dma_spad_subsystem_test"
          ]
        }
      ]
